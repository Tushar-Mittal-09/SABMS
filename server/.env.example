# ==========================================
# Application Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5000
APP_NAME="Smart Auditorium Booking & Management System"
API_PREFIX=/api
API_VERSION=v1
CLIENT_URL=http://localhost:3000
LOG_LEVEL=debug

# ==========================================
# Database Configuration
# ==========================================
MONGODB_URI=mongodb://localhost:27017/sabms_db

# ==========================================
# Authentication & Security (Placeholders)
# ==========================================
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_must_be_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=sabms-backend
JWT_AUDIENCE=sabms-client
JWT_SECRET=dev_jwt_secret_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_must_be_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_REFRESH_COOKIE_PATH=/api/v1/auth
JWT_REFRESH_COOKIE_SAME_SITE=strict

# ==========================================
# Email Configuration (Placeholders)
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_username
SMTP_PASS=placeholder_smtp_password
SMTP_FROM="SABMS Support <noreply@sabms.edu>"

# ==========================================
# Redis Ephemeral Store
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# OTP Cryptographic Configuration
# ==========================================
OTP_HASH_SECRET=placeholder_otp_hmac_secret_key_at_least_16_chars

# ==========================================
# SMS / Twilio Provider Configuration
# ==========================================
SMS_PROVIDER=console
SMS_FROM=SABMS
# Set Twilio credentials below for real SMS dispatch to carriers:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678900

# ==========================================
# Cloudinary Storage Configuration (Placeholders)
# ==========================================
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret
